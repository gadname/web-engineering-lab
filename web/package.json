{
	"name": "taskboard-web",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"type-check": "tsc --noEmit",
		"check": "npm run type-check && biome check .",
		"fix": "biome check --write .",
		"test": "vitest run",
		"test:unit": "vitest run",
		"client:core:generate": "openapi-typescript ../api/openapi.json -o src/services/shared/clients/httpClient/core/client.d.ts",
		"client:ai:generate": "openapi-typescript ../ai/openapi.json -o src/services/shared/clients/httpClient/ai/client.d.ts",
		"client:generate": "npm run client:core:generate && npm run client:ai:generate"
	},
	"dependencies": {
		"@hookform/resolvers": "^3.10.0",
		"@tanstack/react-query": "^5.90.0",
		"clsx": "^2.1.1",
		"next": "^15.5.0",
		"openapi-fetch": "^0.12.2",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.60.0",
		"tailwind-merge": "^2.5.2",
		"zod": "^3.25.67"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.2",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.0.0",
		"@types/node": "^24.0.3",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^4.7.0",
		"autoprefixer": "^10.4.20",
		"jsdom": "^26.0.0",
		"openapi-typescript": "^7.4.1",
		"postcss": "^8.4.47",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	}
}

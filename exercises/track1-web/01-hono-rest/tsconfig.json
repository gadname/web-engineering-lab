{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"types": ["node"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@/tests/*": ["./tests/*"]
		}
	},
	"include": ["src/**/*", "tests/**/*", "scripts/**/*", "vitest.config.ts"],
	"exclude": ["node_modules", "dist"]
}

{
	"name": "02-zod-openapi",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"type-check": "tsc --noEmit",
		"lint": "biome check .",
		"fix": "biome check --write .",
		"check": "npm run type-check && npm run lint",
		"test": "vitest run",
		"openapi:generate": "tsx scripts/generateOpenapi.ts",
		"client:generate": "openapi-typescript generated/openapi.json -o generated/api.d.ts",
		"generate": "npm run openapi:generate && npm run client:generate"
	},
	"dependencies": {
		"@hono/node-server": "^1.14.4",
		"@hono/swagger-ui": "^0.5.2",
		"@hono/zod-openapi": "^0.19.8",
		"hono": "^4.12.19",
		"zod": "^3.25.67"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.2",
		"@types/node": "^24.0.3",
		"openapi-fetch": "^0.12.2",
		"openapi-typescript": "^7.4.0",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	}
}

{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"sourceMap": true,
		"declaration": false
	},
	"tsc-alias": {
		"resolveFullPaths": true,
		"verbose": false
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "tests", "**/*.test.ts"]
}
